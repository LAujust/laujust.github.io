---
layout: default
---
<article class="academic-home">
  <header class="home-heading">
    <h1><strong>{{ site.first_name }}</strong> {{ site.last_name }}</h1>
    <p>Time-domain astrophysics</p>
  </header>

  <div class="home-bio">
    <aside class="home-profile" aria-label="Profile">
      {% assign portrait = page.profile.image | prepend: 'assets/img/' %}
      {% include figure.liquid path=portrait alt=page.profile.alt loading="eager" sizes="(min-width: 800px) 240px, (min-width: 576px) 30vw, 95vw" %}
      <p>Einstein Probe Science Center<br>Beijing, China</p>
    </aside>
    {{ content }}
  </div>

  <nav class="profile-links" aria-label="Contact and academic profiles">
    <a href="mailto:{{ site.data.socials.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i>Email</a>
    <a href="https://orcid.org/{{ site.data.socials.orcid_id }}"><i class="fa-brands fa-orcid" aria-hidden="true"></i>ORCID</a>
    <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>Google Scholar</a>
    <a href="https://github.com/{{ site.data.socials.github_username }}"><i class="fa-brands fa-github" aria-hidden="true"></i>GitHub</a>
  </nav>

  <section class="home-section" aria-labelledby="selected-publications">
    <header class="section-heading">
      <h2 id="selected-publications">Selected publications</h2>
      <a href="{{ '/publications/' | relative_url }}">All publications</a>
    </header>
    {% include selected_papers.liquid %}
  </section>

  <section class="home-section" aria-labelledby="projects">
    <header class="section-heading"><h2 id="projects">Projects</h2></header>
    {% include project_list.liquid %}
  </section>
</article>
