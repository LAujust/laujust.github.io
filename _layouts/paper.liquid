---
---
<article class="paper-entry" id="{{ entry.key | escape }}">
  <h3 class="paper-title"><a href="https://doi.org/{{ entry.doi | escape }}">{{ entry.title }}</a></h3>
  {% assign author_limit = site.max_author_limit | default: 3 %}
  {% assign author_count = entry.author_array | size %}
  {% capture byline %}{% include paper_authors.liquid authors=entry.author_array limit=author_limit %}{% endcapture %}
  {% if author_count > author_limit %}
    <details class="paper-authors">
      <summary>{{ byline | strip }}, et al. <span class="sr-only">Show all {{ author_count }} authors</span></summary>
      <p>{% include paper_authors.liquid authors=entry.author_array limit=author_count %}</p>
    </details>
  {% else %}
    <p class="paper-authors">{{ byline | strip }}</p>
  {% endif %}
  <p class="paper-venue"><cite>{{ entry.journal }}</cite>{% if entry.volume %} {{ entry.volume }}{% endif %}{% if entry.pages %}, {{ entry.pages }}{% endif %} ({{ entry.year }})</p>
  <div class="paper-links">
    <a href="https://doi.org/{{ entry.doi | escape }}">DOI</a>
    {% if entry.eprint %}<a href="https://arxiv.org/abs/{{ entry.eprint | escape }}">arXiv</a>{% endif %}
    {% if entry.abstract %}<details><summary>Abstract</summary><p>{{ entry.abstract }}</p></details>{% endif %}
  </div>
</article>
