{% if site.bib_search %}
  <div class="publication-search" hidden>
    <label for="bibsearch">Filter publications</label>
    <input type="search" id="bibsearch" placeholder="Title, author, journal, or year" autocomplete="off">
    <p id="bibsearch-status" role="status" aria-live="polite"></p>
  </div>
  <script defer src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
