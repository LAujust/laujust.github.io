{% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
{% capture section_links %}
  {% for section in nav_pages %}
    {% unless section.autogen %}
      <a href="{{ section.url | relative_url }}"{% if page.url == section.url %} aria-current="page"{% endif %}>{{ section.title | escape }}</a>
    {% endunless %}
  {% endfor %}
{% endcapture %}
<header class="site-header">
  <div class="site-masthead">
    <a class="site-wordmark" href="{{ '/' | relative_url }}">{{ site.first_name }} {{ site.last_name }}</a>
  </div>
  <nav class="site-navigation" aria-label="Main navigation">
    {{ section_links }}
    <a class="nav-github" href="https://github.com/{{ site.data.socials.github_username }}" aria-label="GitHub profile">
      <i class="fa-brands fa-github" aria-hidden="true"></i>
    </a>
  </nav>
  <details class="mobile-menu">
    <summary><i class="fa-solid fa-bars" aria-hidden="true"></i> Menu</summary>
    <nav aria-label="Mobile navigation">
      {{ section_links }}
      <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
    </nav>
  </details>
</header>
